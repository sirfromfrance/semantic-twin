<?xml version="1.0"?>

<launch>
    <arg name="takeoff_alt" default="7.0"/>
    <arg name="waypoints" default="[-9.0, 3.0, 7.0,  9.0, 3.0, 7.0,  -9.0, 3.0, 7.0,  0.0, 0.0, 7.0]"/>

    <set_env name="GAZEBO_MODEL_PATH"
             value="$(find-pkg-share semantic_twin_assets)/models:$(env GAZEBO_MODEL_PATH /usr/share/gazebo-11/models)"/>

    <include file="$(find-pkg-share gazebo_ros)/launch/gzserver.launch.py">
        <arg name="world" value="$(find-pkg-share semantic_twin)/worlds/disaster.world" />
    </include>
    <include file="$(find-pkg-share gazebo_ros)/launch/gzclient.launch.py" />

    <include file="$(find-pkg-share sdt_uav_platform)/launch/uav_launch.xml">
        <arg name="instance" value="0" />
        <arg name="x" value="0.0"/>
        <arg name="y" value="0.0"/>
        <arg name="takeoff_alt" value="$(var takeoff_alt)"/>
        <arg name="waypoints" value="$(var waypoints)"/>
    </include>

    <node pkg="rqt_image_view" exec="rqt_image_view" name="camera_view" args="/uav0/camera/image_raw" output="log" />
</launch>
