<?xml version="1.0"?>

<launch>
    <arg name="takeoff_alt" default="8.0"/>
    
    <arg name="waypoints" default="[-4.0, 3.0, 8.0,  9.0, 3.0, 8.0,  9.0, -3.0, 8.0,  -6.0, -3.0, 8.0,  0.0, 0.0, 8.0]"/>
    <arg name="max_speed" default="0.5"/>
    <arg name="world_file" default="disaster_scene.world"/>
    <arg name="gui" default="true"/>   <!-- false: no Gazebo window, saves CPU/GPU on a slow machine -->

    <set_env name="GAZEBO_MODEL_PATH"
             value="$(find-pkg-share semantic_twin_assets)/models:$(env GAZEBO_MODEL_PATH /usr/share/gazebo-11/models)"/>

    <include file="$(find-pkg-share gazebo_ros)/launch/gzserver.launch.py">
        <arg name="world" value="$(find-pkg-share semantic_twin)/worlds/$(var world_file)" />
    </include>
    <include file="$(find-pkg-share gazebo_ros)/launch/gzclient.launch.py" if="$(var gui)"/>

    <include file="$(find-pkg-share sdt_uav_platform)/launch/uav_launch.xml">
        <arg name="instance" value="0" />
        <arg name="x" value="0.0"/>
        <arg name="y" value="0.0"/>
        <arg name="takeoff_alt" value="$(var takeoff_alt)"/>
        <arg name="waypoints" value="$(var waypoints)"/>
        <arg name="max_speed" value="$(var max_speed)"/>
    </include>

    <node pkg="rqt_image_view" exec="rqt_image_view" name="debug_view" args="/debug_image" output="log" />
</launch>
