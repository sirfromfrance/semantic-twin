<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_twin</name>
  <version>0.0.1</version>
  <description>
    Semantic digital twin for search-and-rescue UAV missions in GPS-denied
    environments: person detection (CV), Visual SLAM integration, and
    pixel-to-map transformation that places semantic markers on the 3D map.
  </description>
  <maintainer email="gritsenko5555@gmail.com">valeriia-hrytsenko</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>image_geometry</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <!-- Part 3 (Visual SLAM), installed separately: sudo apt install ros-humble-rtabmap-ros -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>sdt_uav_platform</exec_depend>
  <exec_depend>semantic_twin_assets</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
