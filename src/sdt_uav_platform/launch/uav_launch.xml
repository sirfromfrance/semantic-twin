<?xml version="1.0"?>
<launch>
    <!-- One camera drone: PX4 SITL + MAVROS + Gazebo entity + mission node, all under uav<N>.
         Gazebo itself (world) is started by the caller. -->
    <arg name="instance" default="0"/>
    <arg name="x" default="0.0"/>
    <arg name="y" default="0.0"/>
    <arg name="sdf_model" default="px4_iris0_cam.sdf"/>
    <arg name="takeoff_alt" default="5.0"/>
    <arg name="land_at_end" default="false"/>
    <arg name="waypoints" default="[0.0, 0.0, 2.0]"/>
    <arg name="autostart" default="false"/>
    <arg name="max_speed" default="1.0"/>
    <arg name="start_mission" default="true"/>
    <let name="drone_ns" value="uav$(var instance)"/>

    <include file="$(find-pkg-share sdt_uav_platform)/launch/px4_sitl_launch.xml">
        <arg name="instance" value="$(var instance)"/>
    </include>

    <include file="$(find-pkg-share sdt_uav_platform)/launch/mavros_launch.xml">
        <arg name="instance" value="$(var instance)"/>
    </include>

    <node pkg="gazebo_ros" exec="spawn_entity.py" name="spawn_$(var drone_ns)" output="log"
          args="-entity $(var drone_ns) -file $(find-pkg-share sdt_uav_platform)/models/$(var sdf_model) -x $(var x) -y $(var y) -z 0.5"/>

  
    <node pkg="tf2_ros" exec="static_transform_publisher" name="tf_base_to_camera" output="log"
          args="--x 0.1 --y 0 --z 0.05 --yaw 0 --pitch 0.785398 --roll 0 --frame-id base_link --child-frame-id camera_link"/>
    <node pkg="tf2_ros" exec="static_transform_publisher" name="tf_camera_to_optical" output="log"
          args="--x 0 --y 0 --z 0 --yaw -1.5707963 --pitch 0 --roll -1.5707963 --frame-id camera_link --child-frame-id camera_optical_frame"/>

    <group if="$(var start_mission)">
        <push-ros-namespace namespace="$(var drone_ns)"/>
        <node pkg="sdt_uav_platform" exec="mission_node" name="mission" output="screen">
            <param name="takeoff_alt" value="$(var takeoff_alt)"/>
            <param name="land_at_end" value="$(var land_at_end)"/>
            <param name="waypoints" value="$(var waypoints)" type="yaml"/>
            <param name="autostart" value="$(var autostart)"/>
            <param name="max_speed" value="$(var max_speed)"/>
        </node>
    </group>
</launch>
