<?xml version="1.0"?>
<launch>
    <arg name="instance" default="0" />
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="iris"/>
    <set_env name="PX4_SIM_HOST_ADDR" value="0.0.0.0"/>
    <set_env name="PX4_SIM_MODEL" value="$(var vehicle)" />
    <set_env name="PX4_ESTIMATOR" value="$(var est)" />
    <node name="sitl_$(var instance)" pkg="sdt_uav_platform"
          exec="$(find-pkg-share sdt_uav_platform)/scripts/px4.sh" output="log" args="$(var instance)" />
</launch>
